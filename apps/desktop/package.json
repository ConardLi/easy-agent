{
  "name": "easy-agent-desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Easy Agent desktop client",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/electron-vite.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/electron-vite.mjs preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "playwright test --project=unit --project=e2e --project=visual",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "visual:baseline": "playwright test --project=baseline"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "clsx": "2.1.1",
    "electron": "44.4.5",
    "electron-vite": "5.0.0",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.2",
    "zustand": "5.0.15"
  }
}
