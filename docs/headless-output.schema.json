{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Easy Agent headless output v1",
  "type": "object",
  "required": ["schema_version", "type", "session_id"],
  "properties": {
    "schema_version": {"const": 1},
    "type": {"enum": ["system", "assistant", "user", "result"]},
    "session_id": {"type": "string", "minLength": 1}
  },
  "oneOf": [
    {
      "properties": {
        "type": {"const": "system"},
        "subtype": {"const": "init"},
        "cwd": {"type": "string"},
        "model": {"type": "string"},
        "permissionMode": {"enum": ["default", "plan", "auto"]},
        "tools": {"type": "array", "items": {"type": "string"}},
        "slash_commands": {"type": "array", "items": {"type": "string"}},
        "agents": {"type": "array", "items": {"type": "string"}},
        "output_style": {"type": "string"}
      },
      "required": ["subtype", "cwd", "model", "permissionMode", "tools", "slash_commands", "agents", "output_style"]
    },
    {
      "properties": {
        "type": {"enum": ["assistant", "user"]},
        "message": {
          "type": "object",
          "properties": {
            "role": {"enum": ["assistant", "user"]},
            "content": {"type": ["string", "array"]}
          },
          "required": ["role", "content"]
        }
      },
      "required": ["message"]
    },
    {
      "properties": {
        "type": {"const": "result"},
        "subtype": {"enum": ["success", "error_max_turns", "error_during_execution"]},
        "is_error": {"type": "boolean"},
        "result": {"type": "string"},
        "num_turns": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "total_cost_usd": {"type": ["number", "null"], "minimum": 0},
        "usage": {
          "type": "object",
          "required": ["input_tokens", "output_tokens"],
          "properties": {
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "cache_creation_input_tokens": {"type": "integer", "minimum": 0},
            "cache_read_input_tokens": {"type": "integer", "minimum": 0}
          }
        }
      },
      "required": ["subtype", "is_error", "result", "num_turns", "duration_ms", "total_cost_usd", "usage"]
    }
  ]
}
