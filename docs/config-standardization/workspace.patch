+import { useState } from "react";
+import { CodeBlock } from "../chat/Markdown";
+import { Modal } from "../customize/shared";
+import { Button } from "../ui/primitives";
+
+/** URL-driven states keep the model editor's migration flow available in the style reference. */
+export function ConfigMigrationNotice() {
+  const state = new URLSearchParams(window.location.search).get("migration");
+  const [preview, setPreview] = useState(false);
+  const [applied, setApplied] = useState(false);
+  if (!["legacy", "conflict"].includes(state ?? "") || applied) return null;
+  const conflict = state === "conflict";
+  return <div className="mx-10 mt-6 rounded-xl border border-warning/25 bg-warning/5 p-4 text-[12px] text-fg-2">
+    <div className="flex items-center justify-between gap-4"><span className="font-medium text-fg">配置需要处理</span>
+      <Button size="sm" variant="secondary" onClick={() => setPreview(true)}>预览迁移</Button></div>
+    <p className="mt-2 text-fg-3">旧配置已停止生效。请预览差异后手动迁移；应用时备份原文件并重建运行环境。</p>
+    <Modal open={preview} title="配置迁移预览" width={680} onOpenChange={setPreview} footer={<>
+      <Button variant="ghost" onClick={() => setPreview(false)}>关闭</Button>
+      <Button variant="primary" disabled={conflict} onClick={() => { setApplied(true); setPreview(false); }}>备份并应用</Button>
+    </>}>
+      <p className="mb-3 text-[12px] text-fg-3">~/.easy-agent/settings.json</p>
+      <p className={`mb-3 text-[12px] ${conflict ? "text-danger" : "text-fg-2"}`}>{conflict
+        ? "旧凭据来源不同：请选择一个 API Key，解决冲突后重新预览。"
+        : "defaultModel → model；agentMdExcludes 保留全部排除项。认证只引用所属 Profile 的一个 API Key。"}</p>
+      <CodeBlock code={JSON.stringify(conflict ? { connection: { apiKey: "[redacted]", conflict: true } } : {
+        model: "main", agentMdExcludes: ["**/AGENT.md"], reasoning: { mode: "auto" },
+      }, null, 2)} lang="json" />
+    </Modal>
+  </div>;
+}
