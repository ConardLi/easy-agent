{
  "name": "eagent",
  "version": "0.1.1",
  "description": "Terminal coding agent that reads, edits, and runs your code under permission rules, with OS sandboxing, MCP, skills, sub-agents, and Anthropic, OpenAI-compatible, Gemini, or local models",
  "type": "module",
  "bin": {
    "eagent": "dist/eagent.js",
    "easy-agent": "dist/eagent.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ConardLi/easy-agent.git"
  },
  "homepage": "https://github.com/ConardLi/easy-agent#readme",
  "bugs": {
    "url": "https://github.com/ConardLi/easy-agent/issues"
  },
  "scripts": {
    "dev": "tsx src/entrypoint/cli.ts",
    "typecheck": "tsc --noEmit",
    "check:source-hygiene": "node --import tsx scripts/check-source-hygiene.ts",
    "build": "tsup",
    "start": "node dist/eagent.js",
    "prepack": "npm run typecheck && npm run build",
    "prepublishOnly": "npm run verify:release",
    "test:queryengine": "tsx src/scripts/test-queryengine-characterization.ts",
    "test:cli-headless": "node --import tsx src/scripts/test-cli-headless-characterization.ts",
    "test:user-output": "node --import tsx src/scripts/test-user-output-contract.ts",
    "test:config-session": "node --import tsx src/scripts/test-config-session-characterization.ts",
    "test:config-trust": "node --import tsx src/scripts/test-config-trust-boundary.ts && node --import tsx src/scripts/test-config-trust-cli.ts",
    "test:project-memory": "node --import tsx src/scripts/test-project-memory-files.ts",
    "test:feature-config": "node --import tsx src/scripts/test-feature-config.ts",
    "test:providerstream": "tsx src/scripts/test-providerstream-characterization.ts",
    "test:prompt-caching": "node --import tsx src/scripts/test-prompt-caching.ts && node --import tsx src/scripts/test-session-prompt-context.ts",
    "test:command-help": "node --import tsx src/scripts/test-command-help.ts",
    "test:notices": "tsx src/scripts/test-useagentsession-notices.ts",
    "test:streaming": "tsx src/scripts/test-streaming.ts",
    "test:tools": "tsx src/scripts/test-tools.ts",
    "test:tool-input": "node --import tsx src/scripts/test-tool-input-validation.ts",
    "test:max-turns": "node --import tsx src/scripts/test-max-turns.ts",
    "test:path-boundary": "node --import tsx src/scripts/test-path-boundary.ts",
    "test:private-data": "node --import tsx src/scripts/test-private-data-permissions.ts",
    "test:persistence": "node --import tsx src/scripts/test-atomic-persistence.ts",
    "test:controlled-process": "node --import tsx src/scripts/test-controlled-process.ts",
    "test:bash-readonly": "node --import tsx src/scripts/test-bash-readonly.ts",
    "test:tasks": "tsx src/scripts/test-tasks.ts",
    "test:toolsearch": "node --import tsx src/scripts/test-toolsearch.ts && node --import tsx src/scripts/test-toolsearch-integration.ts",
    "test:toolsearch:live": "node --import tsx src/scripts/test-toolsearch-live.ts",
    "test:mcp": "tsx src/scripts/test-mcp.ts",
    "test:mcp:hardening": "node --import tsx src/scripts/test-mcp-hardening.ts",
    "test:skills": "tsx src/scripts/test-skills.ts",
    "test:sandbox": "node --import tsx src/scripts/test-sandbox.ts",
    "test:agents": "tsx src/scripts/test-agents.ts",
    "test:stage20": "tsx src/scripts/test-stage20.ts",
    "test:stage21": "tsx src/scripts/test-stage21.ts",
    "test:team-lifecycle": "node --import tsx src/scripts/test-team-lifecycle.ts",
    "test:stage22": "tsx src/scripts/test-stage22.ts",
    "test:hooks-hardening": "node --import tsx src/scripts/test-hooks-hardening.ts",
    "test:stage23": "tsx src/scripts/test-stage23.ts",
    "test:stage24": "tsx src/scripts/smoke-stage24.tsx",
    "test:stage24-md": "tsx src/scripts/smoke-markdown.tsx",
    "test:stage24-clear": "tsx src/scripts/smoke-static-clear.tsx",
    "test:stage24-resize": "tsx src/scripts/smoke-resize-repaint.tsx",
    "test:stage24-ui": "tsx src/scripts/smoke-ui.tsx",
    "test:stage24-ask": "tsx src/scripts/smoke-question.tsx",
    "test:stage24-transcript": "tsx src/scripts/smoke-transcript.tsx",
    "test:stage24-perm": "tsx src/scripts/smoke-permission.tsx",
    "test:stage24-stream": "tsx src/scripts/smoke-bash-stream.ts",
    "test:stage24-input": "tsx src/scripts/smoke-input.tsx",
    "test:stage24-group": "tsx src/scripts/smoke-group.tsx",
    "test:bash-output": "tsx src/scripts/smoke-bash-output.tsx",
    "test:condensed": "tsx src/scripts/smoke-condensed.tsx",
    "test:tool-states": "tsx src/scripts/smoke-tool-states.tsx",
    "test:bash-progress": "tsx src/scripts/smoke-bash-progress.tsx",
    "test:bash-heartbeat": "tsx src/scripts/smoke-bash-heartbeat.tsx",
    "test:live-group": "tsx src/scripts/smoke-live-group.tsx",
    "test:tool-tags": "tsx src/scripts/smoke-tool-tags.tsx",
    "test:tool-card-format": "node --import tsx src/scripts/test-tool-card-format.ts",
    "test:transcript-wheel": "tsx src/scripts/smoke-transcript-wheel.tsx",
    "test:stage24-statusline": "tsx src/scripts/smoke-statusline.tsx",
    "test:stage24-command": "tsx src/scripts/smoke-command.tsx",
    "test:stage25": "tsx src/scripts/smoke-config.ts",
    "test:stage30": "tsx scripts/verify-multi-protocol.ts",
    "test:stage31": "tsx src/scripts/test-stage31.ts",
    "test:stage32": "tsx src/scripts/test-stage32.ts",
    "test:stage33": "tsx src/scripts/test-stage33.ts",
    "test:stage35": "node --import tsx src/scripts/test-stage35.ts",
    "test:stage35-ui": "tsx src/scripts/test-stage35-ui.tsx",
    "test:stage36": "npm run typecheck && npm run build && node --import tsx src/scripts/test-stage36.ts",
    "verify:production:tests": "node --import tsx scripts/verify-production.ts",
    "verify:production:core": "node --import tsx scripts/verify-production.ts --group core",
    "verify:production:extensions": "node --import tsx scripts/verify-production.ts --group extensions",
    "verify:production:ui": "node --import tsx scripts/verify-production.ts --group ui",
    "verify:production:platform": "node --import tsx scripts/verify-production.ts --group platform",
    "verify:production:live": "node --import tsx scripts/verify-production.ts --group live",
    "verify:production": "npm run typecheck && npm run check:source-hygiene && npm run build && npm run verify:production:tests",
    "verify:release": "npm run verify:production && npm run verify:production:platform && node --import tsx src/scripts/test-stage36.ts",
    "verify:plugin": "tsx src/scripts/verify-plugin-compat.ts",
    "test:filehistory": "tsx src/scripts/smoke-filehistory.ts",
    "test:resilience": "tsx src/scripts/smoke-resilience.ts",
    "smoke:sandbox": "node --import tsx src/scripts/smoke-sandbox.ts",
    "smoke:bash-sandbox": "node --import tsx src/scripts/smoke-bash-sandbox.ts"
  },
  "keywords": [
    "agent",
    "agentic",
    "ai",
    "anthropic",
    "cli",
    "coding-agent",
    "coding-assistant",
    "developer-tools",
    "gemini",
    "llm",
    "mcp",
    "openai",
    "sandbox",
    "terminal"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/diff": "^7.0.2",
    "@types/he": "^1.2.3",
    "@types/node": "^25.5.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.14",
    "@types/turndown": "^5.0.6",
    "ajv": "^8.20.0",
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "diff": "^9.0.0",
    "dotenv": "^17.4.1",
    "he": "^1.2.0",
    "ignore": "^7.0.5",
    "ink": "^7.0.0",
    "llm-bridge": "^2.0.1",
    "marked": "^18.0.4",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.4",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  }
}
